{
      "File template *.h": {
            "prefix": "fileTemplate_h",
            "body": [
                  "/**",
                  " ******************************************************************************",
                  " * @file    ${TM_FILENAME}",
                  " * @author  Daniel Dyringer",
                  " * @date    ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
                  " * @brief   <Provide some short description here>",
                  " ******************************************************************************",
                  " */",
                  "",
                  "/* Define to prevent recursive inclusion ----------------------------------- */",
                  "#ifndef ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H_",
                  "#define ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H_",
                  "",
                  "/* Includes ---------------------------------------------------------------- */",
                  "",   
                  "",
                  "/* Constants and macros ---------------------------------------------------- */",
                  "// clang-format off",
                  "",
                  "",
                  "// clang-format on",
                  "",
                  "/* Types ------------------------------------------------------------------- */",
                  "",
                  "",
                  "/* Exposed API ------------------------------------------------------------- */",
                  "",
                  "",
                  "#endif /* ${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H_ */",
                  "",
                  "/**** END OF FILE ****/",
            ],
            "description": "Insert *.h file template"
      },
      "File template *.c": {
            "prefix": "fileTemplate_c",
            "body": [
                  "/**",
                  " ******************************************************************************",
                  " * @file    ${TM_FILENAME}",
                  " * @author  Daniel Dyringer",
                  " * @date    ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
                  " * @brief   <Provide some short description here>",
                  " ******************************************************************************",
                  " */",
                  "",
                  "",
                  "/* Includes ---------------------------------------------------------------- */",
                  "#include \"${TM_FILENAME_BASE}.h\"",
                  "",
                  "",
                  "/* Constants and macros ---------------------------------------------------- */",
                  "// clang-format off",
                  "",
                  "",
                  "// clang-format on",
                  "",
                  "/* Private types ----------------------------------------------------------- */",
                  "",
                  "",
                  "/* Private variables ------------------------------------------------------- */",
                  "",
                  "",
                  "/* Private functions ------------------------------------------------------- */",
                  "",
                  "",
                  "/* Exposed API ------------------------------------------------------------- */",
                  "",
                  "",
                  "/**** END OF FILE ****/",
            ],
            "description": "Insert *.c file template"
      }
}