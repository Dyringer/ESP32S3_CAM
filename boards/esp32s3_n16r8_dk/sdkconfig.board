# Board: esp32s3_n16r8_dk — ESP32-S3-WROOM-1 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash size (module has 16 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Quad flash on this module; QIO doubles code fetch bandwidth over the DIO
# default. Lives in the bootloader too, so changing it needs a USB reflash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Octal PSRAM (R8 = 8 MB octal SPIRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 80 MHz PSRAM — camera frame buffers live here; the 40 MHz default halves
# the bandwidth available for DMA copy-out and JPEG streaming.
CONFIG_SPIRAM_SPEED_80M=y

# Full S3 clock — WiFi/lwIP throughput and JPEG streaming are CPU-bound at 160.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32 KB I-cache (default 16) cuts flash refetch misses after cache-disabled
# flash ops (OTA erase/write). Costs 16 KB of internal SRAM.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Custom partition table for this board (sized for 16 MB flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp32s3_n16r8_dk/partitions.csv"
